%p{style: "color: green"}= notice

%h1.title Todos os Filmes

%table#movies
  %thead
    %tr
      %th{class: ('hilite' if @sort == 'title')}= link_to "Título", movies_path(sort: "title"), id: 'title_header'
      %th Classificação
      %th Sinopse
      %th{class: ('hilite' if @sort == 'release_date')}= link_to "Lançamento", movies_path(sort: "release_date"), id: 'release_date_header'
      %th Detalhes
  %tbody
    - @movies.each do |movie|
      %tr
        %td= movie.title
        %td= movie.rating
        %td= movie.description
        %td= movie.release_date.strftime("%d/%m/%Y") if movie.release_date
        %td= link_to "Ver Detalhes", movie_path(movie)

%br
= link_to "Novo Filme", new_movie_path